---
import { getCollection, render } from 'astro:content';
import StackBadges from '../StackBadges.astro';
import { formatMonthYear } from '../../utils/date';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const entries = (await getCollection('experiences', ({ data }) => data.lang === lang))
  .sort((a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf());

type Group = { company: string; role: string; entries: typeof entries };
const groups: Group[] = [];
for (const entry of entries) {
  const last = groups.at(-1);
  if (last && last.company === entry.data.company) last.entries.push(entry);
  else groups.push({ company: entry.data.company, role: entry.data.role, entries: [entry] });
}

const renderedGroups = await Promise.all(
  groups.map(async (group) => {
    const items = await Promise.all(
      group.entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content }))
    );
    const startDate = group.entries.reduce(
      (min, e) => (e.data.startDate < min ? e.data.startDate : min),
      group.entries[0].data.startDate
    );
    const hasOngoing = group.entries.some((e) => !e.data.endDate);
    const endDate = hasOngoing
      ? undefined
      : group.entries.reduce(
          (max, e) => (e.data.endDate! > max ? e.data.endDate! : max),
          group.entries[0].data.endDate!
        );
    return { company: group.company, role: group.role, period: { startDate, endDate }, items };
  })
);
---
<h1>{t('experiences.title')}</h1>
<p class="intro">{t('experiences.intro')}</p>
<ol class="timeline">
  {renderedGroups.map((group) => (
    <li>
      <p class="period kicker">
        {formatMonthYear(group.period.startDate, lang)} — {group.period.endDate
          ? formatMonthYear(group.period.endDate, lang)
          : t('experiences.today')}
      </p>
      <h2>{group.role} · {group.company}</h2>
      {group.items.map(({ entry, Content }) => (
        group.items.length > 1 && entry.data.mission ? (
          <>
            <h3 class="mission">{entry.data.mission}</h3>
            <p class="mission-period">
              {formatMonthYear(entry.data.startDate, lang)} — {entry.data.endDate
                ? formatMonthYear(entry.data.endDate, lang)
                : t('experiences.today')}
            </p>
            <p class="summary">{entry.data.summary}</p>
            <div class="details"><Content /></div>
            <StackBadges stack={entry.data.stack} />
          </>
        ) : (
          <>
            <p class="summary">{entry.data.summary}</p>
            <div class="details"><Content /></div>
            <StackBadges stack={entry.data.stack} />
          </>
        )
      ))}
    </li>
  ))}
</ol>
<style>
  .intro { color: var(--muted); max-width: 38rem; margin-block: 0.75rem 3rem; }
  .timeline { list-style: none; padding: 0; }
  .timeline li {
    border-left: 2px solid var(--accent);
    padding: 0 0 3rem 1.75rem;
    position: relative;
  }
  .timeline li::before {
    content: '';
    position: absolute;
    left: -6px;
    top: 0.4rem;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent);
  }
  .period { margin-bottom: 0.4rem; }
  h2 { font-size: 1.45rem; }
  .summary { margin-block: 0.6rem; max-width: 40rem; }
  .details { color: var(--muted); font-size: 0.95rem; max-width: 40rem; margin-bottom: 1rem; }
  .details :global(ul) { padding-left: 1.1rem; }
  .mission { font-size: 1.1rem; margin-top: 1.5rem; }
  .mission-period { color: var(--muted); font-size: 0.85rem; margin-bottom: 0.4rem; }
</style>
