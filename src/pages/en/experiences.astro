---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExperiencesView from '../../components/views/ExperiencesView.astro';
import { useTranslations } from '../../i18n/ui';
import { experienceIntro } from '../../utils/career';
const t = useTranslations('en');
---
<BaseLayout
  lang="en"
  title={`${t('experiences.title')} — Kamel Azizi`}
  description={await experienceIntro('en')}
  alternateHref="/experiences/"
>
  <ExperiencesView lang="en" />
</BaseLayout>
